# 中华共和实录·野 —— 生产环境配置
# 由 install.sh 生成；修改后执行：systemctl restart gonghe

# 运行环境：prod 会关闭 Gin 调试输出
APP_ENV=prod

# 监听地址。只给本机 nginx 反代时用 127.0.0.1:8090 更安全
ADDR=:8090

# 数据目录与 SQLite 文件
DATA_DIR=__DATA_DIR__
DB_PATH=__DATA_DIR__/gonghe.db

# 前端静态文件目录（install.sh 会把 web/ 放在这里）
STATIC_DIR=__PREFIX__/web

# JWT 签名密钥。务必保密；更换后所有已登录用户需重新登录
JWT_SECRET=__JWT_SECRET__
JWT_TTL=168h

# 是否开放注册
ALLOW_REGISTER=true

# 空库首次启动是否写入演示史官与示例史枝。
# 公开部署建议设为 false，避免出现口令为 123456 的演示账号。
SEED_DEMO=__SEED_DEMO__

# 分页
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# SQLite 连接与性能
DB_MAX_OPEN_CONNS=4
DB_MAX_IDLE_CONNS=4
DB_CACHE_KB=16384
DB_BUSY_TIMEOUT=5s
DB_MMAP_MB=32
